{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "enabledManagers": [
    "npm",
    "github-actions",
    "dockerfile",
    "pep621"
  ],
  "packageRules": [
    {
      "groupName": "non-major dependencies",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "matchManagers": [
        "github-actions",
        "dockerfile"
      ],
      "pinDigests": true
    }
  ]
}
